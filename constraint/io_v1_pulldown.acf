PINOUT(V1), STANDARD(LVCMOS33) {
    pin io_led[0][0] B21
    pin io_led[0][1] B20
    pin io_led[0][2] B18
    pin io_led[0][3] B17
    pin io_led[0][4] B15
    pin io_led[0][5] B14
    pin io_led[0][6] B12
    pin io_led[0][7] B11
    pin io_led[1][0] B9
    pin io_led[1][1] B8
    pin io_led[1][2] B6
    pin io_led[1][3] B5
    pin io_led[1][4] B3
    pin io_led[1][5] B2
    pin io_led[1][6] A24
    pin io_led[1][7] A23
    pin io_led[2][0] A21
    pin io_led[2][1] A20
    pin io_led[2][2] A18
    pin io_led[2][3] A17
    pin io_led[2][4] A15
    pin io_led[2][5] A14
    pin io_led[2][6] A12
    pin io_led[2][7] A11

    PULL(DOWN) {
        pin io_dip[0][0] B30
        pin io_dip[0][1] B31
        pin io_dip[0][2] B33
        pin io_dip[0][3] B34
        pin io_dip[0][4] B36
        pin io_dip[0][5] B37
        pin io_dip[0][6] B39
        pin io_dip[0][7] B40
        // pin io_dip[0][0] C28 // LED 1
        // pin io_dip[0][1] C27 // LED 2
        // pin io_dip[0][2] C31 // LED 3
        // pin io_dip[0][3] C30 // LED 4
        // pin io_dip[0][4] C34 // LED 5
        // pin io_dip[0][5] C33 // LED 6
        // pin io_dip[0][6] C37 // LED 7
        // pin io_dip[0][7] C36 // LED 8
        pin io_dip[1][0] B42
        pin io_dip[1][1] B43
        pin io_dip[1][2] B45
        pin io_dip[1][3] B46
        pin io_dip[1][4] B48
        pin io_dip[1][5] B49
        pin io_dip[1][6] A27
        pin io_dip[1][7] A28
        pin io_dip[2][0] A30
        pin io_dip[2][1] A31
        pin io_dip[2][2] A33
        pin io_dip[2][3] A34
        pin io_dip[2][4] A36
        pin io_dip[2][5] A37
        pin io_dip[2][6] A39
        pin io_dip[2][7] A40

        pin io_button[0] B28 //start btn
        pin io_button[1] B27 //clear
        pin io_button[2] B23 //skip
        pin io_button[3] B24
        pin io_button[4] C49
    }
    
    // pin buttonCountSelect[0] C48
    
    // pin buttonCountSegment[0] C23
    // pin buttonCountSegment[1] C24
    // pin buttonCountSegment[2] C20
    // pin buttonCountSegment[3] C21
    // pin buttonCountSegment[4] C17
    // pin buttonCountSegment[5] C18
    // pin buttonCountSegment[6] C14
    // pin buttonCountSegment[7] C15
    
    
    pin io_select[0] A9 // first digit of 2-digit seven segment
    pin io_select[1] A8 // second digit of 2-digit seven segment
    pin io_select[2] A42
    pin io_select[3] A43
    
    pin io_segment[0] A5 // a
    pin io_segment[1] A6 // b
    pin io_segment[2] A48 // c
    pin io_segment[3] A46 // d
    pin io_segment[4] A45 // e
    pin io_segment[5] A3 // f
    pin io_segment[6] A2 // g
    pin io_segment[7] A49
}

