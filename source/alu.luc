module alu (
    input a[32],
    input b[32],
    input alufn[6],
    output out[32],
    output z,
    output v,
    output n
) {
    
    sig out_sig[32]
    adder adder(#SIZE(32))
    adder cmp_adder(#SIZE(32))
    // compare compare
    shifter shifter
    
    always {
        z = 0
        v = 0
        n = 0
        adder.a = a
        adder.b = b
        adder.alufn_signal = alufn
        
        cmp_adder.a = a
        cmp_adder.b = b
        cmp_adder.alufn_signal = 6b000001
        
        // compare.z = cmp_adder.z
        // compare.v = cmp_adder.v
        // compare.n = cmp_adder.n
        // compare.alufn = alufn
        
        shifter.a = a
        shifter.b = b
        shifter.alufn = alufn[1:0]
        
        case(alufn){
            6h00: // ADD
                adder.alufn_signal = 6h00
                out_sig = adder.out
                z = ~|out_sig
                v = (a[31] & (b[31] ^ alufn[0]) & !out_sig[31]) | (!a[31] & !(b[31] ^ alufn[0]) & out_sig[31]) 
                n = out_sig[31]
            6h01: // SUB
                adder.alufn_signal = 6h01
                out_sig = adder.out
                z = ~|out_sig
                v = (a[31] & (b[31] ^ alufn[0]) & !out_sig[31]) | (!a[31] & !(b[31] ^ alufn[0]) & out_sig[31]) 
                n = out_sig[31]   
            6h02: // MUL
                out_sig = a * b 
            6h18: // BITWISE AND
                out_sig = a & b 
            6h1E: // BITWISE OR 
                out_sig = a | b 
            6h16: // BITWISE XOR
                out_sig = a ^ b 
            6h1A: // "A"
                out_sig = a
            6h20: // SHL 
                out_sig = shifter.out
                // out_sig = a << b[4:0]
            6h21: // SHR 
                out_sig = shifter.out
                // out_sig = a >> b[4:0]
            6h23: // SRA 
                out_sig = shifter.out
                // out_sig = a >>> b[4:0]
            6h33: // CMPEQ 
                // compare.alufn = alufn
                // out_sig = compare.cmp    
                out_sig = a == b 
            6h35: // CMPLT 
                // compare.alufn = alufn
                // out_sig = compare.cmp
                out_sig = a < b 
            6h37: // CMPLE
                // compare.alufn = alufn
                // out_sig = compare.cmp
                out_sig = a <= b
            default:
                out_sig = 0
        }

        out = out_sig        
    }
}