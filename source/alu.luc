module alu (
    input a[32],
    input b[32],
    input alufn[6],
    output out[32],
    output z,
    output v,
    output n
) {
    mux_4 alu_mux[32]
    mux_4 arith_mux[32]
    
    rca adder(#BITS(32)) // 2 units: add & subtract
    // multiplier multiplier() // 1 Mutiplier unit
    // modulo modulo()
    // division division()
    // boolean boolean(#SIZE(32)) // 4 boolean units
    shifter shifter() // 3 shifter units
    compare compare() // 3 compare units
    
    rca cmp_adder(#BITS(32))
    
    always {
        // Assembling Adder
        adder.a = a
        adder.b = b
        adder.alufn = alufn[0]
        
        // Assembling Multiplier
        // multiplier.a = a
        // multiplier.b = b
        
        // Assembling Modulo
        // modulo.a = a
        // modulo.b = b
        
        // Assembling Hamming Distance
        // division.a = a
        // division.b = b
        
        repeat(i, 32){
            arith_mux.s0[i] = alufn[1]
            arith_mux.s1[i] = alufn[2]
            arith_mux.in[i][0] = adder.s[i]
            arith_mux.in[i][1] = 0
            // arith_mux.in[i][2] = division.out[i]
            arith_mux.in[i][2] = 0
            arith_mux.in[i][3] = 0
        }
        
        // Assembling Boolean
        // boolean.a = a
        // boolean.b = b
        // boolean.alufn = alufn
        
        // Assembling Shifter
        shifter.a = a
        shifter.b = b
        shifter.alufn = alufn
        
        // Assembling Compare (with helper cmp_adder)
        cmp_adder.a = a
        cmp_adder.b = b
        cmp_adder.alufn = 1
        
        compare.z = cmp_adder.z
        compare.v = cmp_adder.v
        compare.n = cmp_adder.n
        compare.alufn = alufn
        
        repeat(i, 32){
            alu_mux.s0[i] = alufn[4]
            alu_mux.s1[i] = alufn[5]
            alu_mux.in[i][0] = arith_mux.out[i]
            // alu_mux.in[i][1] = boolean.bool[i]
            alu_mux.in[i][1] = 0
            alu_mux.in[i][2] = shifter.shift[i]
            if(~|i){
                alu_mux.in[i][3] = compare.cmp
            } else {
                alu_mux.in[i][3] = 1b0
            }
        }
        
        out = alu_mux.out

        z = adder.z
        v = adder.v
        n = adder.n
    }
}