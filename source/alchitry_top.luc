                alu.b[31:3] = 29b0
                alu.b[2:0] = generator.num[2:0]
            3b010:
                alu.b = 32h3
            3b011:
                if(firstBtnDetect.out == 1){
                    alu.b = 32b000
                } else if(secondBtnDetect.out == 1){
                    alu.b = 32b001
                } else if(thirdBtnDetect.out == 1){
                    alu.b = 32b010
                } else if(fourthBtnDetect.out == 1){
                    alu.b = 32b011
                } else if(fifthBtnDetect.out == 1){
                    alu.b = 32b100
                } else if(sixthBtnDetect.out == 1){
                    alu.b = 32b101
                } else if(seventhBtnDetect.out == 1){
                    alu.b = 32b110
                } else if(eighthBtnDetect.out == 1){
                    alu.b = 32b111
                }
            3b100:
                alu.b = 32b1
            3b101:
                if(control_system.button_count == 0){
                    alu.b = 32d21
                } else if(control_system.button_count == 1){
                    alu.b = 32d18
                } else if(control_system.button_count == 2){
                    alu.b = 32d15
                } else if(control_system.button_count == 3){
                    alu.b = 32d12
                } else if(control_system.button_count == 4){
                    alu.b = 32d9
                } else if(control_system.button_count == 5){
                    alu.b = 32d6
                } else if(control_system.button_count == 6){
                    alu.b = 32d3
                } else if(control_system.button_count == 7){
                    alu.b = 32d0
                }
            3b110:
                alu.b = 32b0
        }
        
        if(firstBtnDetect.out == 1 || secondBtnDetect.out == 1 || thirdBtnDetect.out == 1 ||
            fourthBtnDetect.out == 1 || fifthBtnDetect.out == 1 || sixthBtnDetect.out == 1 ||
            seventhBtnDetect.out == 1 || eighthBtnDetect.out == 1
        ){
            control_system.button_input = 1
        } else {
            control_system.button_input = 0
        }
        
        regfile_system.read_address_1 = control_system.ra
        regfile_system.read_address_2 = control_system.rb
        regfile_system.write_enable = control_system.we
        regfile_system.write_address = control_system.wa
        regfile_system.clear_reg = control_system.clear_reg
        regfile_system.reset_score = control_system.reset_score
        regfile_system.write_data = alu.out
        
        generator.next = control_system.gen_next
        alu.alufn = control_system.alufn
        
        if(control_system.led_enable && (~slowclock.value)){
            if(generator.num[2:0] == 3b000){
                firstLED = 1
            } else if(generator.num[2:0] == 3b001){
                secondLED = 1
            } else if(generator.num[2:0] == 3b010){
                thirdLED = 1
            } else if(generator.num[2:0] == 3b011){
                fourthLED = 1
            } else if(generator.num[2:0] == 3b100){
