            } else if(generator.num[2:0] == 3b110){
                seventhLED = 1
            } else if(generator.num[2:0] == 3b111){
                eighthLED = 1
            }
        }
        
        if(regfile_system.hearts_remaining == 3){
            heart1LED = 1
            heart2LED = 1
            heart3LED = 1
        } else if(regfile_system.hearts_remaining == 2){
            heart1LED = 0
            heart2LED = 1
