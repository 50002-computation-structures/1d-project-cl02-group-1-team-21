module alchitry_top (
    input clk,              // 100MHz clock
    input rst_n,            // reset button (active low)
    output led[8],          // 8 user controllable LEDs
    input usb_rx,           // USB->Serial input
    output usb_tx,          // USB->Serial output
    output io_led[3][8],    // LEDs on IO Shield
    output io_segment[8],   // 7-segment LEDs on IO Shield
    output io_select[4],    // Digit select on IO Shield
    input io_button[5],     // 5 buttons on IO Shield
    input io_dip[3][8],      // DIP switches on IO Shield
    input startBtnIn,
    input clearBtnIn,
    input firstBtnIn,
    input secondBtnIn,
    input thirdBtnIn,
    input fourthBtnIn,
    input fifthBtnIn,
    input sixthBtnIn,
    input seventhBtnIn,
    input eighthBtnIn,
    output firstLED,
    output secondLED,
    output thirdLED,
    output fourthLED,
    output fifthLED,
    output sixthLED,
    output seventhLED,
    output eighthLED
) {
    
    const CLK_FREQ = $is_sim() ? 1000 : 10000000 // put 1000 for sim, 10000000 otherwise in hardware
    
    sig rst                 // reset signal
    
    alu alu
    
    .clk(clk) {
        // The reset conditioner is used to synchronize the reset signal to the FPGA
        // clock. This ensures the entire FPGA comes out of reset at the same time.
        reset_conditioner reset_cond
        
        edge_detector timer(#RISE(1), #FALL(0))
        
        button_conditioner firstBtnCond(#CLK_FREQ(CLK_FREQ))
        button_conditioner secondBtnCond(#CLK_FREQ(CLK_FREQ))
        button_conditioner thirdBtnCond(#CLK_FREQ(CLK_FREQ))
        button_conditioner fourthBtnCond(#CLK_FREQ(CLK_FREQ))
        button_conditioner fifthBtnCond(#CLK_FREQ(CLK_FREQ))
        button_conditioner sixthBtnCond(#CLK_FREQ(CLK_FREQ))
        button_conditioner seventhBtnCond(#CLK_FREQ(CLK_FREQ))
        button_conditioner eighthBtnCond(#CLK_FREQ(CLK_FREQ))
        button_conditioner startBtnCond(#CLK_FREQ(CLK_FREQ))
        button_conditioner clearBtnCond(#CLK_FREQ(CLK_FREQ))
        
        edge_detector firstBtnDetect(#RISE(1), #FALL(0))
        edge_detector secondBtnDetect(#RISE(1), #FALL(0))
        edge_detector thirdBtnDetect(#RISE(1), #FALL(0))
        edge_detector fourthBtnDetect(#RISE(1), #FALL(0))
        edge_detector fifthBtnDetect(#RISE(1), #FALL(0))
        edge_detector sixthBtnDetect(#RISE(1), #FALL(0))
        edge_detector seventhBtnDetect(#RISE(1), #FALL(0))
        edge_detector eighthBtnDetect(#RISE(1), #FALL(0))
        edge_detector startBtnDetect(#RISE(1), #FALL(0))
        edge_detector clearBtnDetect(#RISE(1), #FALL(0))
        
        .rst(rst) {
            // Reduce DIV values for simulation so it doesn't take forever
            multi_seven_seg seg (#DIV($is_sim() ? 1 : 16), #DIGITS(4))
            multi_decimal_counter dec_ctr(#DIGITS(4))
            counter slowclock (#SIZE(1), #DIV($is_sim() ? 8 : 26))
            
            regfile_unit regfile_system
            control_unit control_system
            pn_gen generator
        }
    }
    
    always {
        reset_cond.in = ~rst_n  // input raw inverted reset signal
        rst = reset_cond.out    // conditioned reset
        
        io_led = 3x{{8h00}}
        io_segment = 8hff
        io_select = 4hf
        led = c{3b0, io_button} // connect buttons to LEDs
        usb_tx = usb_rx         // loop serial port
        io_segment = ~seg.seg // connect segments to the driver
        io_select = ~seg.sel  // connect digit select to the driver
        io_led = io_dip       // connect the DIP switches to the LEDs
        
        timer.in = slowclock.value
        dec_ctr.inc = timer.out
        seg.values = dec_ctr.digits
        
        firstLED = 0
        secondLED = 0
        thirdLED = 0
        fourthLED = 0
        fifthLED = 0
        sixthLED = 0
        seventhLED = 0
        eighthLED = 0
        
        firstBtnCond.in = firstBtnIn
        firstBtnDetect.in = firstBtnCond.out
        secondBtnCond.in = secondBtnIn
        secondBtnDetect.in = secondBtnCond.out
        thirdBtnCond.in = thirdBtnIn
        thirdBtnDetect.in = thirdBtnCond.out
        fourthBtnCond.in = fourthBtnIn
        fourthBtnDetect.in = fourthBtnCond.out
        fifthBtnCond.in = fifthBtnIn
        fifthBtnDetect.in = fifthBtnCond.out
        sixthBtnCond.in = sixthBtnIn
        sixthBtnDetect.in = sixthBtnCond.out
        seventhBtnCond.in = seventhBtnIn
        seventhBtnDetect.in = seventhBtnCond.out
        eighthBtnCond.in = eighthBtnIn
        eighthBtnDetect.in = eighthBtnCond.out
        startBtnCond.in = startBtnIn
        startBtnDetect.in = startBtnCond.out
        clearBtnCond.in = clearBtnIn
        clearBtnDetect.in = clearBtnCond.out
        
        control_system.startBtn = startBtnDetect.out
        control_system.clearBtn = clearBtnDetect.out
        control_system.timer = timer.out
        
        if (regfile_system.score >= d100){
            seg.values = {4b0, 4b0, 4b0, 4b0}
            io_segment = ~seg.seg
            io_select = 4b1111
        } else {
            if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d0, 4d0}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d0, 4d1}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d0, 4d2}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d0, 4d3}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d0, 4d4}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d0, 4d5}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d0, 4d6}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d0, 4d7}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d0, 4d8}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d0, 4d9}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d1, 4d0}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d1, 4d1}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d1, 4d2}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d1, 4d3}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d1, 4d4}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d1, 4d5}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d1, 4d6}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d1, 4d7}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d1, 4d8}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d1, 4d9}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d2, 4d0}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d2, 4d1}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d2, 4d2}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d2, 4d3}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d2, 4d4}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d2, 4d5}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d2, 4d6}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d2, 4d7}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d2, 4d8}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d2, 4d9}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d3, 4d0}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d3, 4d1}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d3, 4d2}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d3, 4d3}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d3, 4d4}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d3, 4d5}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d3, 4d6}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d3, 4d7}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d3, 4d8}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d3, 4d9}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d4, 4d0}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d4, 4d1}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d4, 4d2}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d4, 4d3}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d4, 4d4}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d4, 4d5}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d4, 4d6}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d4, 4d7}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d4, 4d8}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d4, 4d9}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d5, 4d0}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d5, 4d1}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d5, 4d2}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d5, 4d3}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d5, 4d4}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d5, 4d5}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d5, 4d6}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d5, 4d7}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d5, 4d8}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d5, 4d9}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d6, 4d0}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d6, 4d1}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d6, 4d2}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d6, 4d3}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d6, 4d4}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d6, 4d5}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d6, 4d6}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d6, 4d7}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d6, 4d8}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d6, 4d9}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d7, 4d0}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d7, 4d1}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d7, 4d2}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d7, 4d3}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d7, 4d4}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d7, 4d5}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d7, 4d6}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d7, 4d7}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d7, 4d8}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d7, 4d9}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d8, 4d0}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d8, 4d1}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d8, 4d2}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d8, 4d3}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d8, 4d4}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d8, 4d5}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d8, 4d6}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d8, 4d7}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d8, 4d8}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d8, 4d9}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d9, 4d0}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d9, 4d1}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d9, 4d2}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d9, 4d3}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d9, 4d4}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d9, 4d5}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d9, 4d6}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d9, 4d7}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d9, 4d8}
            }else if (regfile_system.score == 0){
            		seg.values = {control_system.button_count, 4b0, 4d9, 4d9}
            }
            
            io_segment = ~seg.seg
            io_select = ~seg.sel
        }
        
        generator.seed = 32b1
        alu.b = 32b0
        if(control_system.asel == 0){
            alu.a = regfile_system.read_data_1
        } else {
            alu.a = 32b0
        }
        
        case(control_system.bsel){
            3b000:
                alu.b = regfile_system.read_data_2
            3b001:
                alu.b[31:3] = 29b0
                alu.b[2:0] = generator.num[2:0]
            3b010:
                alu.b = 32h3
            3b011:
                if(firstBtnDetect.out == 1){
                    alu.b = 32b000
                } else if(secondBtnDetect.out == 1){
                    alu.b = 32b001
                } else if(thirdBtnDetect.out == 1){
                    alu.b = 32b010
                } else if(fourthBtnDetect.out == 1){
                    alu.b = 32b011
                } else if(fifthBtnDetect.out == 1){
                    alu.b = 32b100
                } else if(sixthBtnDetect.out == 1){
                    alu.b = 32b101
                } else if(seventhBtnDetect.out == 1){
                    alu.b = 32b110
                } else if(eighthBtnDetect.out == 1){
                    alu.b = 32b111
                }
            3b100:
                alu.b = 32b1
        }
        
        if(firstBtnDetect.out == 1 || secondBtnDetect.out == 1 || thirdBtnDetect.out == 1 ||
            fourthBtnDetect.out == 1 || fifthBtnDetect.out == 1 || sixthBtnDetect.out == 1 ||
            seventhBtnDetect.out == 1 || eighthBtnDetect.out == 1
        ){
            control_system.button_input = 1
        } else {
            control_system.button_input = 0
        }
        
        regfile_system.read_address_1 = control_system.ra
        regfile_system.read_address_2 = control_system.rb
        regfile_system.write_enable = control_system.we
        regfile_system.write_address = control_system.wa
        regfile_system.clear_reg = control_system.clear_reg
        regfile_system.reset_score = control_system.reset_score
        regfile_system.write_data = alu.out
        
        generator.next = control_system.gen_next
        alu.alufn = control_system.alufn
        
        if(control_system.led_enable && (~slowclock.value)){
            if(generator.num[2:0] == 3b000){
                firstLED = 1
            } else if(generator.num[2:0] == 3b001){
                secondLED = 1
            } else if(generator.num[2:0] == 3b010){
                thirdLED = 1
            } else if(generator.num[2:0] == 3b011){
                fourthLED = 1
            } else if(generator.num[2:0] == 3b100){
                fifthLED = 1
            } else if(generator.num[2:0] == 3b101){
                sixthLED = 1
            } else if(generator.num[2:0] == 3b110){
                seventhLED = 1
            } else if(generator.num[2:0] == 3b111){
                eighthLED = 1
            }
        }
        
        control_system.is_correct = regfile_system.is_correct
    }
}